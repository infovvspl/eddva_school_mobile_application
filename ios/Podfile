# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'SchoolStudentPortalNative' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'SchoolStudentPortalNativeTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # fmt 11.0.2 (pinned by RN 0.77) fails to compile under Xcode 16.3+ / 26 clang:
    # FMT_STRING's consteval constructor is rejected as "not a constant expression".
    # Fixed upstream in fmt 11.1; until RN bumps it, force fmt's own (supported)
    # non-consteval path. base.h defines FMT_USE_CONSTEVAL unconditionally, so a
    # -D flag cannot win -- the header itself has to be patched after each install.
    fmt_base_h = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base_h)
      contents = File.read(fmt_base_h)
      marker = "#if FMT_USE_CONSTEVAL\n#  define FMT_CONSTEVAL consteval"
      patch = "#undef FMT_USE_CONSTEVAL\n#define FMT_USE_CONSTEVAL 0\n"
      unless contents.include?(patch)
        raise "fmt/base.h: FMT_USE_CONSTEVAL block not found" unless contents.include?(marker)
        mode = File.stat(fmt_base_h).mode
        File.chmod(0644, fmt_base_h)
        File.write(fmt_base_h, contents.sub(marker, patch + marker))
        File.chmod(mode & 0o7777, fmt_base_h)
        Pod::UI.puts "[fmt] disabled consteval (Xcode 16.3+ workaround)".green
      end
    end
  end
end
